# ─── Sarvam AI ────────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=amit

# ─── LLM (open-source, e.g. Groq-hosted Llama-3.1-8B or local Ollama) ─────────
LLM_PROVIDER=groq                          # groq | ollama
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# For Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                            # leave blank for local dev
QDRANT_COLLECTION_NAME=fraud_advisories

# ─── mem0 ─────────────────────────────────────────────────────────────────────
MEM0_API_KEY=                              # leave blank to use local qdrant-backed mem0
MEM0_PROVIDER=local                        # local | mem0ai (cloud)

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=fraud-advisory-store

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# ─── Next.js (public vars must start with NEXT_PUBLIC_) ───────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FraudGuard AI

# ─── Auth (simple JWT for demo; replace with proper auth in production) ────────
JWT_SECRET=change_this_to_a_random_secret_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
